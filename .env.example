# ローカルでは `make setup` がこのファイルをもとに .env.local を作る。
# Supabase の値は、ローカルの Supabase（`supabase start`）のものが自動で入る。
# 本番・プレビューの値は Vercel の環境変数に入れる（このファイルには書かない）。

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Drizzle が使う DB の接続文字列（Vercel ではトランザクションプーラーの URL）
DATABASE_URL=

# Cloudflare Access（member / admin の JWT 検証）。ローカルでは空でよい
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# このメールでログインした人を admin にする
ADMIN_EMAIL=

# ローカル専用：member / admin の画面と API を、このメールでログインしたことにして試す。
# admin で試すときは ADMIN_EMAIL と同じにする。Vercel には入れない
DEV_STAFF_EMAIL=member.local@example.com
