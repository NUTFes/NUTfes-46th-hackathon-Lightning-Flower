# ローカルでは `make setup` がこのファイルをもとに .env.local を作る（.env.local はコミットしない）。
# Supabase の値は、ローカルの Supabase（`supabase start`）のものが自動で入る。
# 本番・プレビューの値は Vercel の環境変数に入れる（このファイルには書かない）。

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Drizzle が使う DB の接続文字列（Vercel ではトランザクションプーラーの URL）
DATABASE_URL=

# Cloudflare Access（member / admin の JWT 検証）。ローカルでは空でよい
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# このメールでログインした人を admin にする。リポジトリが public なので値はここに書かない。
# 値は PM に聞いて .env.local に入れる（本番は Vercel の環境変数）
ADMIN_EMAIL=

# ローカル専用：member / admin の画面と API を、このメールでログインしたことにして試す。
# admin で試すときは ADMIN_EMAIL と同じにする。Vercel には入れない
DEV_STAFF_EMAIL=member.local@example.com

# ローカル専用：アプリを開くポート。3000 がほかで使われているときに変える（変えたら make restart）
APP_PORT=3000
